      "findings": [
        {
          "id": "forged-marker",
          "class": "ownership-trust",
          "severity": "important",
          "round": 2,
          "summary": "The ownership marker carries a sha256 of the body, which anyone who can write a destination can compute, so a forged file is classified owned and --update replaces it.",
          "source": "Codex adversarial review of #30; tracked in issue #31, still open",
          "paths": [
            "scripts/lib.py",
            "scripts/install.py"
          ],
          "evidence_any": [
            "body_sha256",
            "split_marker",
            "inspect\\(",
            "forg",
            "self-describ",
            "not a signature",
            "anyone who can write"
          ],
          "fixed": null,
          "at_base": "observed",
          "repro": {
            "kind": "probe",
            "probe": "forged_marker.py",
            "args": []
          }
        },
        {
          "id": "argv0-escape",
          "class": "output-injection",
          "severity": "minor",
          "round": 1,
          "summary": "Installer usage and error output prints the program name (argv[0]) without escaping, so a hostile name injects terminal escape sequences.",
          "source": "Residual from the #22 reviews, fixed in #34",
          "paths": [
            "scripts/install.py"
          ],
          "evidence_any": [
            "argv\\[0\\]",
            "prog",
            "escape",
            "terminal",
            "argparse"
          ],
          "fixed": "78ab5a0076f45a22e161b0410e7ed4c622ef50e3",
          "at_base": "observed",
          "repro": {
            "kind": "probe",
            "probe": "argv0_escape.py",
            "args": []
          }
        }
      ]
    },
