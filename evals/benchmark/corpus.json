      "findings": [
        {
          "id": "root-target",
          "class": "filesystem-safety",
          "severity": "important",
          "round": 1,
          "summary": "The installer accepts the filesystem root as its target directory, so a typo or a .. can root an install at /.",
          "source": "Codex review of #30; fixed before merge",
          "paths": [
            "scripts/install.py"
          ],
          "evidence_any": [
            "filesystem root",
            "_check_target",
            "target.{0,40}(/|root)",
            "realpath"
          ],
          "fixed": "ac8cbe9addd2eb3e789aac8eccc8691496908fd0",
          "at_base": "observed",
          "repro": {
            "kind": "probe",
            "probe": "root_target.py",
            "args": []
          }
        },
        {
          "id": "invalid-toml",
          "class": "input-validation",
          "severity": "important",
          "round": 1,
          "summary": "A role, fragment, policy or overlay text with a control character renders a Codex agent file that is not valid TOML, and nothing checks the rendered text.",
          "source": "Copilot and Codex review of #30; fixed before merge",
          "paths": [
            "scripts/generate.py"
          ],
          "evidence_any": [
            "tomllib",
            "valid(ate|ation)?.{0,30}TOML",
            "TOML.{0,40}(invalid|parse|valid)",
            "control char"
          ],
          "fixed": "ac8cbe9addd2eb3e789aac8eccc8691496908fd0",
          "at_base": "n/a",
          "repro": {
            "kind": "probe",
            "probe": "codex_toml.py",
            "args": []
          }
        }
      ]
    },
    {
