      "roles": [
        "reviewer",
        "adversarial-reviewer"
      ],
      "kind": "diff",
      "title": "Review the Codex adapter pull request as merged (#30)",
      "base": "ef7c9393aeab1904734af819b4ce4f0cd2adbfa5",
