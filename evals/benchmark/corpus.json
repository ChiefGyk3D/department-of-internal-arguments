    {
      "id": "lead-install-first-head",
      "roles": [
        "reviewer",
        "adversarial-reviewer"
      ],
      "kind": "diff",
      "title": "Review the first head of the lead persona installer (#35, issues #32 and #33)",
      "base": "78ab5a0076f45a22e161b0410e7ed4c622ef50e3",
      "head": "03c209ba768f8671399ba102de18b24211acd7a8",
      "diff_sha256": "193ee7092eddb270b35d875ba475d569c63b4b7a950c7b7a290aaa9d0edcc7a7",
      "findings": [
        {
          "id": "lead-list-hides-unsafe",
          "class": "error-reporting",
          "severity": "important",
          "round": 1,
          "summary": "list-managed --lead returns no row for a directory or another non-regular file, so an unsafe instruction file reads as clean by omission.",
          "source": "Codex adversarial review of #35, round 1",
          "paths": [
            "scripts/install.py"
          ],
          "evidence_any": [
            "_lead_row",
            "return None",
            "no row",
            "omit",
            "symlink",
            "clean",
            "list_managed"
          ],
          "fixed": "0e37b5b2864399ed454d01a342f6bc7e8f948609",
          "at_base": "n/a",
          "repro": {
            "kind": "probe",
            "probe": "lead_list.py",
            "args": [
              "directory"
            ]
          }
        },
        {
          "id": "lead-list-hides-oversized",
          "class": "error-reporting",
          "severity": "important",
          "round": 1,
          "summary": "list-managed --lead silently drops an oversized (over 1 MiB) lead file from the listing.",
          "source": "Copilot review of #35",
          "paths": [
            "scripts/install.py"
          ],
          "evidence_any": [
            "MAX_MANAGED_BYTES",
            "oversize",
            "1 MiB",
            "return None",
            "silently",
            "omit",
            "_lead_row"
          ],
          "fixed": "0e37b5b2864399ed454d01a342f6bc7e8f948609",
          "at_base": "n/a",
          "repro": {
            "kind": "probe",
            "probe": "lead_list.py",
            "args": [
              "oversized"
            ]
          }
        },
        {
          "id": "lead-lost-update",
          "class": "concurrency",
          "severity": "important",
          "round": 1,
          "summary": "The writer checks only the inode before rename, not the content it built the new file from, so an in-place edit made after the first read is lost.",
          "source": "Codex adversarial review of #35, round 1",
          "paths": [
            "scripts/install.py"
          ],
          "evidence_any": [
            "lost.update",
            "race",
            "TOCTOU",
            "st_ino",
            "re-?check",
            "rename",
            "changed (during|while)",
            "(stat|inode)"
          ],
          "fixed": "0e37b5b2864399ed454d01a342f6bc7e8f948609",
          "at_base": "n/a",
          "repro": {
            "kind": "pattern",
            "path": "scripts/install.py",
            "regex": "def _recheck",
            "present": false
          }
        }
      ]
    },
